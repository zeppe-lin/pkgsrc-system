#!/bin/sh
#
# /etc/rc.d/saslauthd: start/stop sasl authentication daemon
#

USER=root

SSD=/sbin/start-stop-daemon
PROG=/usr/sbin/saslauthd
PID=/run/saslauthd/saslauthd.pid
OPTS="-a shadow"

case $1 in
start)
	install -o $USER -d /run/saslauthd
	$SSD --start --pidfile $PID --exec $PROG -- $OPTS
	;;
stop)
	$SSD --stop --pidfile $PID --retry 30
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --verbose --pidfile $PID --exec $PROG
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
