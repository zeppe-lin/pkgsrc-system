# Description: Library of PNG support functions with APNG support
# URL:         http://www.libpng.org/
# Depends on:  zlib

name=libpng
version=1.6.56
release=1
source="$name-$version.tar.gz::https://github.com/pnggroup/$name/archive/refs/tags/v$version.tar.gz
	$name-1.6.54-apng.patch"

build() {
	# https://src.openmamba.org/rpms/libpng/raw/branch/main/libpng-1.6.54-apng.patch
	patch -d $name-$version -p1 -i $SRC/$name-1.6.54-apng.patch

	mkdir build; cd build

	../$name-$version/configure \
		--prefix=/usr \
		--enable-hardware-optimizations \

	make V=1
	make DESTDIR=$PKG install
}
