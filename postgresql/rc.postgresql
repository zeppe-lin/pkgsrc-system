#!/bin/sh -e
#
# /etc/rc.d/postgresql: start/stop PostgreSQL server postmaster
#

RUN_AS=postgres
LOG=/var/log/postgresql
RUNDIR=/run/postgresql
DATADIR=/var/pgsql/data

case "$1" in
start|stop|status|restart|reload)
	[ -e $RUNDIR ] || install -o $RUN_AS -g $RUN_AS -d $RUNDIR
	sudo -u postgres pg_ctl -D $DATADIR -l $LOG $1
	;;
*)
	echo "Usage: $0 {start|stop|restart|reload|status}"
	;;
esac

# End of file.
