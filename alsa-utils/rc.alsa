#!/bin/sh -e
#
# /etc/rc.d/alsa: store/restore ALSA mixer levels
#

PROG=/usr/sbin/alsactl
STATE=/var/lib/alsa/asound.state

case $1 in
start)
	# Restore mixer levels; if no state exists, initialize one
	if [ -f "$STATE" ]; then
		$PROG restore
	else
		$PROG store
		$PROG restore
	fi
	;;
stop)
	# Save current mixer levels to state file
	$PROG store
	;;
restart)
	$0 stop
	sleep 2
	$0 start
	;;
status)
	# Report whether a state file exists and its timestamp
	if [ -f "$STATE" ]; then
		echo "ALSA state file present ($STATE), updated $(date -r "$STATE" '+%F %T')"
	else
		echo "No ALSA state file found"
	fi
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
