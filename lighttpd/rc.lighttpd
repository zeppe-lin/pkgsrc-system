#!/bin/sh
#
# /etc/rc.d/lighttpd: start/stop lighttpd(8) daemon
#

CHROOT=/var/www/lighttpd

SSD=/sbin/start-stop-daemon
PROG=/usr/sbin/lighttpd
PID=/run/lighttpd.pid
OPTS="-f /etc/lighttpd.conf"

case $1 in
start)
	# Ensure chroot environment has /dev/null
	[ -e "$CHROOT/dev/null" ] || mknod -m 0666 "$CHROOT/dev/null" c 1 3

	$SSD --start --pidfile $PID --exec $PROG -- $OPTS
	;;
stop)
	$SSD --stop --remove-pidfile --pidfile $PID --retry 10
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --verbose --pidfile $PID --exec $PROG
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
