#!/bin/sh -e
#
# /etc/rc.d/cpufreq: start/stop cpufreq settings
#
# See ``apropos cpufreq'' to obtain more information.
#

START_GOVERNOR=ondemand
STOP_GOVERNOR=performance

set_governor() {
	gov=$1
	logger "cpufreq: setting governor=$gov"
	for cpu in $(/usr/bin/cpufreq-info -o | awk '/^CPU /{ print $2 }'); do
		if ! /usr/bin/cpufreq-set -c "$cpu" --governor "$gov"; then
			echo "Failed to set governor on CPU $cpu" >&2
			exit 1
		fi
	done
}

show_status() {
	for cpu in $(/usr/bin/cpufreq-info -o | awk '/^CPU /{ print $2 }'); do
		echo "CPU$cpu: $(/usr/bin/cpufreq-info -c "$cpu" -p)"
	done
}

case $1 in
start)
	set_governor "$START_GOVERNOR"
	;;
stop)
	set_governor "$STOP_GOVERNOR"
	;;
restart)
	$0 stop
	sleep 2
	$0 start
	;;
status)
	show_status
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
