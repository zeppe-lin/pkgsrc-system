#!/bin/sh -e
#
# /etc/rc.d/openvpn: start/stop openvpn(8) daemon
#

# Require a config name
if [ -z "$2" ]; then
	echo "Usage: $0 {start|stop|restart|status} <config-name>" >&2
	exit 1
fi

# Config must exist
if [ ! -f "/etc/openvpn/$2.conf" ]; then
	echo "Config file not found: /etc/openvpn/$2.conf" >&2
	exit 2
fi

# Paths and options
SSD=/sbin/start-stop-daemon
PROG=/usr/sbin/openvpn
PID=/run/openvpn.$2.pid
CONF=/etc/openvpn/$2.conf
OPTS="--fast-io --config $CONF --writepid $PID --daemon ovpn-$2"

case $1 in
start)
	$SSD --start --pidfile $PID --exec $PROG -- $OPTS
	;;
stop)
	$SSD --stop --pidfile $PID --remove-pidfile \
		--retry=TERM/30/KILL/5
	;;
restart)
	$0 stop "$2"
	$0 start "$2"
	;;
status)
	$SSD --status --verbose --pidfile $PID --exec $PROG
	;;
*)
	echo "Usage: $0 {start|stop|restart|status} <config-name>"
	;;
esac

# End of file.
