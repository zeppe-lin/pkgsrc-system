# Description: VPN Client
# URL:         https://openvpn.net/
# Depends on:  docutils libcap-ng libnsl libtirpc lz4 lzo openssl

name=openvpn
version=2.7.5
release=1
source="https://github.com/OpenVPN/$name/archive/v$version/$name-$version.tar.gz
	manpage.patch
	rc.openvpn"

build() {
	patch -d $name-$version -p1 -i $SRC/manpage.patch

	mkdir build; cd build

	autoreconf -fiv ../$name-$version
	../$name-$version/configure \
		--prefix=/usr \
		--libexecdir=/usr/lib \
		--mandir=/usr/share/man \
		--disable-plugin-auth-pam \
		--disable-unit-tests \
		--enable-iproute2 \

	make V=1
	make DESTDIR=$PKG install

	install -m 0755 -D $SRC/rc.openvpn $PKG/etc/rc.d/openvpn

	# Fixup docutils' inability to produce correct .SH NAME
	sed -i -E 's/.SH Name/\U&/' $PKG/usr/share/man/man*/*.[0-9]

	# Remove junk
	rm -r $PKG/usr/share/doc
}
