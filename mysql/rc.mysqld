#!/bin/sh
#
# /etc/rc.d/mysqld: start/stop mysqld(8) daemon
#

SSD=/sbin/start-stop-daemon
PROG=/usr/sbin/mysqld
MYSQL_CFG=/etc/my.cnf
NAME=mysqld
PID=/run/mysql/mysqld.pid
LOG=/var/log/mysqld.log
OPTS="--pid-file=$PID"

case $1 in
start)
	$SSD --start --background --no-close --pidfile $PID \
		--exec $PROG -- $OPTS >> $LOG 2>&1
	;;
stop)
	$SSD --stop --name $NAME --pidfile $PID --remove-pidfile \
		--retry 10
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --verbose --name=$NAME --pidfile $PID
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
