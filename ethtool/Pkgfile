# Description: Linux net driver diagnostic and tuning tool
# URL:         https://www.kernel.org/pub/software/network/ethtool/
# Depends on:  libmnl

name=ethtool
version=6.19
release=1
source=https://git.kernel.org/pub/scm/network/ethtool/ethtool.git/snapshot/ethtool-$version.tar.gz

build() {
	mkdir build; cd build

	autoreconf -fiv ../ethtool-$version
	../ethtool-$version/configure \
		--prefix=/usr \
		--enable-pretty-dump \
		--enable-netlink \

	make V=1
	make DESTDIR=$PKG install

	# Remove junk
	rm -r $PKG/usr/share/metainfo
}
