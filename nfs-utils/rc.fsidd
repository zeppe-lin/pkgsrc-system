#!/bin/sh
#
# /etc/rc.d/fsidd: start/stop File System ID daemon
#

SSD=/sbin/start-stop-daemon
PROG=/usr/sbin/fsidd
NAME=fsidd
PID=/run/fsidd.pid
OPTS="--foreground"

case $1 in
start)
	$SSD --start --background --make-pidfile --pidfile $PID \
		--exec $PROG -- $OPTS
	;;
stop)
	$SSD --stop --remove-pidfile --pidfile $PID --retry=10
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --verbose --pidfile $PID --name $NAME
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
