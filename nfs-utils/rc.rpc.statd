#!/bin/sh
#
# /etc/rc.d/rpc.statd: start/stop NSM service daemon
#
# See rpc.statd(8) for more information.
#

SSD=/sbin/start-stop-daemon
PROG=/usr/sbin/rpc.statd
NAME=rpc.statd
PID=/run/rpc.statd.pid
OPTS="--no-notify"

case $1 in
start)
	$SSD --start --pidfile $PID --exec $PROG -- $OPTS
	;;
stop)
	$SSD --stop --pidfile $PID --retry 10 --name $NAME
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --verbose --pidfile $PID --name $NAME
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
