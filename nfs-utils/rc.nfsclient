#!/bin/sh
#
# /etc/rc.d/nfs: start/stop NFS client mounts
#

case $1 in
start)
	/bin/mount -a -t nfs
	;;
stop)
	/bin/umount -a -t nfs,nfs4
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	if [ -n "$(/bin/findmnt -t nfs,nfs4)" ]; then
		echo 'NFS mounts are active'
	else
		echo 'no NFS mounts active'
	fi
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
