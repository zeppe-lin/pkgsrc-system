#!/bin/sh
#
# /etc/rc.d/nfsdcld: start/stop NFSv4 Client Tracking Daemon
#
# See nfsdcld(8) for more information.
#

SSD=/sbin/start-stop-daemon
PROG=/usr/sbin/nfsdcld
PID=/run/nfsdcld.pid
OPTS="--foreground"

case $1 in
start)
	$SSD --start --background --no-close --make-pidfile \
		--pidfile $PID --exec $PROG -- $OPTS
	;;
stop)
	$SSD --stop --remove-pidfile --pidfile $PID --retry 10
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --verbose --pidfile $PID --exec $PROG
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
