#!/bin/sh
#
# /etc/rc.d/rpc.idmapd: start/stop NFSv4 ID <-> Name Mapper daemon
#
# See rpc.idmapd(8) for more information.
#

SSD=/sbin/start-stop-daemon
PROG=/usr/sbin/rpc.idmapd
PID=/run/rpc.idmapd.pid
OPTS="-f"

case $1 in
start)
	$SSD --start --background --make-pidfile --pidfile $PID \
		--exec $PROG -- $OPTS 
	;;
stop)
	$SSD --stop --remove-pidfile --pidfile $PID --retry 10
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --verbose --pidfile $PID --exec $PROG
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
