#!/bin/sh
#
# /etc/rc.d/rpc.nfsd: start/stop NFS server process
#
# See rpc.nfsd(8) for more information.
#

# Number of NFS server threads
NPROC=8

SSD=/sbin/start-stop-daemon
PROG=/usr/sbin/rpc.nfsd
NAME="nfsd"
OPTS="--syslog"

case $1 in
start)
	$SSD --start --exec $PROG -- $OPTS $NPROC
	;;
stop)
	$SSD --start --exec $PROG -- $OPTS 0
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --verbose --name $NAME
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
