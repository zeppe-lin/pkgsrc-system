#!/bin/sh
#
# /etc/rc.d/dhcpcd: start/stop dhcpcd(8) client daemon
#

DEV=eth0

SSD=/sbin/start-stop-daemon
PROG=/sbin/dhcpcd
PID=/run/dhcpcd/$DEV.pid
OPTS="--quiet --allowinterfaces $DEV"

case $1 in
start)
	$SSD --start --pidfile $PID --exec $PROG -- $OPTS $DEV
	;;
stop)
	$SSD --stop --pidfile $PID --retry 10
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --verbose --pidfile $PID --exec $PROG
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
