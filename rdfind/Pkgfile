# Description: Redundant data find
# URL:         https://rdfind.pauldreik.se/
# Depends on:  nettle

# Maintainer notes on dependencies:
#   xxhash: xxHash checksum support (enabled if installed)

name=rdfind
version=1.8.0
release=1
source=https://rdfind.pauldreik.se/$name-$version.tar.gz

build() {
	mkdir build; cd build

	autoreconf -fiv ../$name-$version
	../$name-$version/configure \
		--prefix=/usr

	make V=1
	make DESTDIR=$PKG install
}
